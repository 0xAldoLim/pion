{
  "name": "pion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/0xAldoLim/pion",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:deep": "node scripts/prepare-assets.mjs --deep",
    "validate:data": "node scripts/validate-data.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "calibrate": "node scripts/calibrate-bots.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.4.2",
    "chess.js": "1.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-window": "7.4.1"
  }
}
